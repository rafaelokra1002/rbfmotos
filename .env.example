# ==== Banco de dados (PostgreSQL) ====
# Em produção (Coolify), use a connection string do PostgreSQL criado no Coolify.
# Exemplo: postgres://usuario:senha@host:5432/rbfmotos
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rbfmotos?schema=public"

# ==== Servidor ====
# Porta onde o Express serve o site + API. No Coolify normalmente é injetada.
PORT=3000

# ==== Frontend (opcional) ====
# Deixe em branco para usar o caminho relativo /api (mesma origem, recomendado).
# Só preencha se a API estiver em outro domínio.
# VITE_API_URL=
